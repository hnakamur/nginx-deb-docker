     }
 
+    if (ccf->worker_cgroup_path_format.len) {
+        nginx_worker_cgroup_limit_memory(cycle, worker);
+    }
+
     if (geteuid() == 0) {
         if (setgid(ccf->group) == -1) {
             ngx_log_error(NGX_LOG_EMERG, cycle->log, ngx_errno,
